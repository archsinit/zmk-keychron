#include <dt-bindings/zmk/matrix_transform.h>

/ {

    /*
     * B1 Pro ANSI hardware revision used by USB PID 0x071A
     * (Keychron Launcher device profile 875824922).
     *
     * The GPIO scan configuration remains the Keychron B1 Pro configuration;
     * this transform maps the 0x071A matrix coordinates back to the normal
     * physical ANSI key order expected by the stock keymap.
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <8>;
        map = <
            // esc         // f1        // f2        // f3         // f4        // f5        // f6        // f7        // f8        // f9        // f10       // f11       // f12       // del
            RC(7,5)       RC(1,2)      RC(3,4)      RC(1,14)      RC(1,4)      RC(2,2)      RC(4,2)      RC(2,5)      RC(2,6)      RC(2,7)      RC(2,10)     RC(2,8)      RC(3,7)      RC(5,8)
            // grave       // 1         // 2         // 3          // 4         // 5         // 6         // 7         // 8         // 9         // 0         // -         // =         // backspace
            RC(0,17)      RC(1,0)      RC(1,15)     RC(1,1)       RC(3,6)      RC(1,12)     RC(1,13)     RC(5,5)      RC(5,6)      RC(5,7)      RC(5,10)     RC(1,6)      RC(1,7)      RC(1,8)
            // tab         // q         // w         // e          // r         // t         // y         // u         // i         // o         // p         // [         // ]         // backslash
            RC(0,5)       RC(0,10)     RC(0,8)      RC(0,9)       RC(0,13)     RC(0,14)     RC(3,5)      RC(3,1)      RC(1,3)      RC(2,4)      RC(1,11)     RC(4,6)      RC(4,7)      RC(4,10)
            // caps        // a         // s         // d          // f         // g         // h         // j         // k         // l         // ;         // '                      // enter
            RC(5,17)      RC(0,4)      RC(0,6)      RC(0,7)       RC(0,2)      RC(1,17)     RC(6,8)      RC(1,10)     RC(3,2)      RC(1,9)      RC(6,5)      RC(6,7)                  RC(2,1)
            // lshift                    // z         // x          // c         // v         // b         // n         // m         // ,         // .         // /                      // rshift
            RC(0,16)                    RC(0,0)      RC(0,15)      RC(0,1)      RC(0,12)     RC(0,11)     RC(7,6)      RC(7,11)     RC(7,10)     RC(7,8)      RC(7,9)                  RC(5,15)
            // lctrl       // win l      // alt l                                             // space                     // alt r      // fn        // left       // up        // down       // right
            RC(1,5)       RC(3,10)      RC(6,17)                                            RC(0,3)                     RC(4,0)      RC(2,9)      RC(3,17)      RC(2,17)     RC(4,17)     RC(7,17)
            // m/w         // bt         // 2.4g       // charging   // charge done
            RC(8,0)       RC(8,1)       RC(8,2)       RC(8,3)       RC(8,4)
        >;
    };
};
